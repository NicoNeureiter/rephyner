<package name="rephyner" version="0.0.1">
  <depends on='BEAST.base' atleast='2.7.2'/>
  <depends on='BEAST.app' atleast='2.7.2'/>
  <depends on='CoalRe' atleast='1.0.0'/>
  <depends on='TargetedBeast' atleast='1.0.0'/>

  <service type="beast.base.core.BEASTInterface">
    <provider classname="rephyner.distribution.UniformTree"/>
    <provider classname="rephyner.distribution.ReducedCoalescent"/>
    <provider classname="rephyner.distribution.LearnedReducedNetworkPrior"/>
    <provider classname="rephyner.distribution.UniformReducedNetworkPrior"/>
    <provider classname="rephyner.distribution.NetworkDistribution"/>
    <provider classname="rephyner.distribution.NetworkIntervals"/>
    <provider classname="rephyner.network.SegmentTreeInitializer"/>
    <provider classname="rephyner.operators.DivertSingleSegmentOperator"/>
    <provider classname="rephyner.operators.localtreeoperators.LocalTreeSubtreeSlide"/>
    <provider classname="rephyner.operators.localtreeoperators.LocalTreeSPR"/>
    <provider classname="rephyner.operators.localtreeoperators.LocalTreeSPRTargeted"/>
    <provider classname="rephyner.operators.localtreeoperators.LocalTreeWilsonBalding"/>
    <provider classname="rephyner.operators.localtreeoperators.LocalTreeWilsonBaldingTargeted"/>
    <provider classname="rephyner.operators.networkedgeoperators.NetworkEdgeSlide"/>
    <provider classname="rephyner.operators.networkedgeoperators.NetworkEdgeRangeSlide"/>
    <provider classname="rephyner.operators.networkedgeoperators.NetworkEdgeWilsonBalding"/>
    <provider classname="rephyner.operators.networkedgeoperators.NetworkEdgeWilsonBaldingTargeted"/>
    <provider classname="rephyner.operators.DivertSegmentOperator"/>
    <provider classname="rephyner.operators.NetworkScaleOperator"/>
    <provider classname="rephyner.operators.UniformNetworkNodeHeightOperator"/>
    <provider classname="rephyner.simulator.ReducedFromFullNetwork"/>
    <provider classname="rephyner.simulator.SimulatedUniformReducedNetwork"/>
    <provider classname="rephyner.statistics.ReducedNetworkLogger"/>
    <provider classname="rephyner.statistics.ReducedNetworkStatsLogger"/>
  </service>

</package>

