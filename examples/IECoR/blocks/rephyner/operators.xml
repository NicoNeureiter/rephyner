
        <!-- Non-network parameter operators -->
        
        <operator id="ucldMeanScaler" spec="ScaleOperator" parameter="@ucldMean" weight="3.0"/>
        <operator id="ucldStdevScaler" spec="ScaleOperator" parameter="@ucldStdev" weight="3.0"/>

        <plate var="concept" range="&concepts;">
            <operator id="ORCAdaptableOperatorSampler_sigma.$(concept)" spec="AdaptableOperatorSampler" weight="1.5">
                <parameter idref="ucldStdev"/>
                <operator id="ORCucldStdevScaler.$(concept)" spec="orc.consoperators.UcldScalerOperator" distr="@ORCLogNormalDistributionModel.$(concept)" rates="@ORCRates.$(concept)" scaleFactor="0.5" stdev="@ucldStdev" weight="1.0"/>
                <operator id="ORCUcldStdevRandomWalk.$(concept)" spec="operator.kernel.BactrianRandomWalkOperator" parameter="@ucldStdev" scaleFactor="0.1" weight="1.0"/>
                <operator id="ORCUcldStdevScale.$(concept)" spec="kernel.BactrianScaleOperator" parameter="@ucldStdev" scaleFactor="0.5" upper="10.0" weight="1.0"/>
            </operator>
        </plate>
        <operator id="bcovAlphaScaler" spec="ScaleOperator" parameter="@bcov_alpha" weight="0.2"/>
        <operator id="bcovSwitchParamScaler" spec="ScaleOperator" parameter="@bcov_s" weight="0.2"/>
        <operator id="frequenciesDelta" spec="DeltaExchangeOperator" delta="0.01" weight="0.5" parameter="@frequencies"/>
        <operator id="FixMeanMutationRatesOperator" spec="operator.kernel.BactrianDeltaExchangeOperator" delta="0.75" weight="2.0">
            <parameter idref="mutationRate"/>
            <parameter idref="mutationRate.s:full"/>
            <parameter idref="mutationRate.s:ant"/>
            <parameter idref="mutationRate.s:burn"/>
            <parameter idref="mutationRate.s:big"/>
            <parameter idref="mutationRate.s:hide"/>
            <parameter idref="mutationRate.s:push"/>
            <weightvector id="weightparameter" spec="parameter.IntegerParameter" dimension="7" estimate="false" lower="0" upper="0">42 289 684 681 493 164 64</weightvector>
        </operator>


        <!-- Node height operators (no topology changes) -->

        <operator id="NetworkScale" spec="NetworkScaleOperator" scaleFactor="0.9" 
                    network="@network" weight="20.0">
            <plate var="concept" range="&concepts;"><segmentTree idref="$(concept).tree"/></plate>
        </operator>

        <operator id="NetworkScaleUpDown" spec="NetworkScaleOperator" scaleFactor="0.9" 
                    network="@network" weight="20.0">
            <plate var="seg" range="&concepts;"><segmentTree idref="$(seg).tree"/></plate>
            <downParameter idref="ucldMean"/>
        </operator>

        <operator id="NetworkScaleRootOnly" spec="NetworkScaleOperator" scaleFactor="0.92"
                    network="@network" scaleRootOnly="true" weight="20.0">
            <plate var="concept" range="&concepts;"><segmentTree idref="$(concept).tree"/></plate>
        </operator>

        <operator id="uniformNetworkNodeHeight" spec="UniformNetworkNodeHeightOperator" network="@network" weight="40.0">
            <plate var="concept" range="&concepts;"><segmentTree idref="$(concept).tree"/></plate>
        </operator>


