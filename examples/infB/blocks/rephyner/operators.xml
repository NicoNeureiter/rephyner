            <operator id="NetworkEdgeWilsonBalding_1.0" spec="NetworkEdgeWilsonBaldingTargeted" network="@network" size="1.0" weight="1">
                <plate var="s" range="&segments;"><segmentTree idref="$(s).tree"/></plate>
