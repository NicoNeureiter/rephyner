<!DOCTYPE note [
  <!ENTITY taxa "${TAXA}">
  <!ENTITY segments "${SEGMENTS}">
]>
<beast version="2.0"
       namespace="beast.pkgmgmt:beast.base.core:beast.base.inference
                 :beast.base.inference.util
                 :beast.base.inference.parameter
                 :beast.base.evolution.alignment
                 :beast.base.evolution.likelihood
                 :beast.base.evolution.tree
                 :beast.base.evolution.tree.coalescent
                 :beast.base.evolution.sitemodel
                 :beast.base.evolution.substitutionmodel
                 :beast.base.evolution.operator
                 :beast.base.inference.distribution
                 :beast.base.inference.distribution.Prior
                 :feast.simulation
                 :rephyner.network
                 :rephyner.statistics
                 :rephyner.simulator
                 :rephyner.distribution
                 :rephyner.operators">

    <run spec="GPSimulator" nSims="1">
        <simulationObject id="network" spec="SimulatedUniformReducedNetwork" fileName="prior/network_${SIMULATION_ID}.tree" maxHeight="3.0" >
            <taxonSet spec="TaxonSet" id="taxonSet">
                <plate var="tax" range="&taxa;">
                    <taxon spec="Taxon" id="$(tax)"/>
                </plate>
            </taxonSet>

            <traitSet spec="TraitSet" traitname="date-backward" id="traitSet" taxa="@taxonSet">
                ${DATES}
            </traitSet>

            <plate var="seg" range="&segments;">
                <segmentTree id="seg$(seg)tree" spec="Tree" taxonset="@taxonSet" trait="@traitSet"/>
            </plate>
        </simulationObject>

        <plate var="seg" range="&segments;">
            <simulationObject id="seg$(seg)align" spec="SimulatedAlignment" outputFileName="simulated_data/seg$(seg)_${SIMULATION_ID}.alignment.nexus"
                    sequenceLength="${SITES_PER_SEGMENT}" tree="@seg$(seg)tree">
                <siteModel spec="SiteModel">
                    <mutationRate spec="RealParameter" value="${CLOCK_RATE}"/>
                    <substModel spec="JukesCantor"/>
                </siteModel>
            </simulationObject>
        </plate>

        <plate var="seg" range="&segments;">
            <logger spec="Logger" fileName="prior/seg$(seg)_${SIMULATION_ID}.tree" logEvery="1">
                <log idref="seg$(seg)tree"/>
            </logger>
        </plate>

        <logger spec="Logger" logEvery="1" fileName="prior/simulation_${SIMULATION_ID}.log">
            <log spec="ReducedNetworkStatsLogger" reducedNetwork="@network"/>
            <plate var="seg" range="&segments;">
                <log spec="TreeStatLogger" tree="@seg$(seg)tree"/>
            </plate>
        </logger>

    </run>

</beast>