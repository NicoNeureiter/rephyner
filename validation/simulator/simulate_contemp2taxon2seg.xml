<beast version="2.0"
       namespace="beast.pkgmgmt
                 :beast.base.core
                 :beast.base.core.util
                 :beast.base.inference
                 :beast.base.inference.parameter
                 :beast.base.evolution.alignment
                 :beast.base.evolution.likelihood
                 :beast.base.evolution.tree
                 :beast.base.evolution.tree.coalescent
                 :beast.base.evolution.sitemodel
                 :beast.base.evolution.substitutionmodel
                 :beast.base.evolution.operators
                 :beast.base.math.distributions
                 :feast.simulation
                 :rephyner.network
                 :rephyner.statistics
                 :rephyner.simulator">

    <network id="network" spec="SimulatedCoalescentNetwork" enableSegmentTreeUpdate="false" nSegments="2">
        <populationModel spec="ConstantPopulation">
            <popSize spec="RealParameter" value="1.0"/>
        </populationModel>

        <reassortmentRate spec="RealParameter" value="1.0"/>

        <taxonSet spec="TaxonSet" id="taxonSet">
            <taxon spec="Taxon" id="t1"/>
            <taxon spec="Taxon" id="t2"/>
        </taxonSet>

        <traitSet spec="TraitSet" traitname="date-backward" id="traitSet" taxa="@taxonSet">
                t1=0.0, t2=0.0
        </traitSet>

        <segmentTree id="segment1" spec="Tree" trait="@traitSet"/>
        <segmentTree id="segment2" spec="Tree" trait="@traitSet"/>
    </network>

    <run spec="GPSimulator" nSims="100000">

        <simulationObject idref="network"/>

        <logger spec="Logger" logEvery="1" mode="tree" fileName="$(filebase).trees">
            <log idref="network"/>
        </logger>

        <logger spec="Logger" logEvery="1" fileName="$(filebase).log">
            <log spec="NetworkStatsLogger" network="@network"/>
        </logger>
    </run>
</beast>